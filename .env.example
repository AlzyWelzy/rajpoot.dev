# ---------------------------------------------------------------------------
# Environment variables for the portfolio site, split into two files by
# which system reads them:
#
#   .env.local  — Vite build-time. Only PUBLIC_*-prefixed vars are inlined
#                 into the built HTML (Astro's convention).
#                 cp .env.example .env.local, keep the PUBLIC_* section.
#
#   .dev.vars   — Wrangler/Workers runtime, read via `cloudflare:workers`'s
#                 `env` at request time. Same file `wrangler dev`/`astro dev`
#                 load locally, and what `wrangler types` introspects.
#                 cp .env.example .dev.vars, keep everything else.
#
# Both files are gitignored. In production, PUBLIC_* vars are set as GitHub
# Actions repo variables (see .github/workflows/deploy-cloudflare.yml);
# runtime secrets are pushed once via
#   wrangler secret put <NAME> --name rajpoot-astro-portfolio
# and persist across deploys — they don't need to be re-set on every push.
# ---------------------------------------------------------------------------

# --- Contact form (Resend) — .dev.vars --------------------------------------

# Required to actually deliver contact-form emails. Without it the form still
# validates and passes Turnstile, but returns a friendly error instead of
# sending. Create a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional. Sender shown on delivered emails, e.g.
#   "Contact Form <contact@rajpoot.dev>"
# Must be on a domain verified in Resend; falls back to the Resend sandbox
# sender (onboarding@resend.dev) if unset.
RESEND_FROM=

# --- Contact-form anti-abuse (Cloudflare Turnstile) — .dev.vars -------------

# Required to test the contact form locally — grab the widget's secret from
# the Cloudflare dashboard (Turnstile → this widget) and paste it here.
# Already pushed to the deployed Worker via `wrangler secret put`, so
# production doesn't need this set here.
TURNSTILE_SECRET=

# Optional. Comma-separated hostnames siteverify's response must match.
# Defaults to the current PUBLIC_SITE_URL's host (bare + www) plus
# localhost/127.0.0.1 — only set this if a deploy needs something more
# specific than that default.
TURNSTILE_HOSTNAMES=

# --- Contact-form anti-abuse (Cloudflare Turnstile) — .env.local ------------

# Public by design (embedded in the rendered HTML). Needed for the widget to
# render at all — without it, every submission fails verification with a
# friendly error. Create/manage the widget at
# https://dash.cloudflare.com/?to=/:account/turnstile.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Site identity — .env.local ----------------------------------------------

# Optional, build-time. Canonical URL for this deploy — feeds metadata,
# JSON-LD, the sitemap, and robots.txt's Host directive (src/lib/seo.ts).
# Falls back to the current interim domain (https://rajpoot.me) if unset.
PUBLIC_SITE_URL=

# --- Analytics (Cloudflare Web Analytics) — .env.local ----------------------

# Optional, build-time. Site token from the Cloudflare dashboard's Web
# Analytics section. Without it the beacon script isn't rendered at all —
# pageviews/Core Web Vitals just won't be collected.
PUBLIC_CF_BEACON_TOKEN=

# --- Feature flags — .env.local ---------------------------------------------

# Optional, build-time. Set to "true" to render the testimonials section;
# hidden by default until there are enough real endorsements. Any other value
# (or unset) keeps it hidden.
SHOW_TESTIMONIALS=

# --- Managed by tooling — .dev.vars ------------------------------------------

# Do not set manually. Present here (rather than only in a comment) so
# `wrangler types` — which infers the Env interface's shape from the *names*
# present in .dev.vars, not from any real value — declares it even on a
# fresh checkout that never ran the app locally. Real value is a Worker var
# injected ad hoc by playwright.config.ts during end-to-end runs.
E2E_TESTING=
