# ---------------------------------------------------------------------------
# Environment variables for the portfolio site.
#
# Local development: copy the runtime values into `.dev.vars` (read by
# `wrangler dev` and by the adapter's platformProxy) and the build-time ones
# into `.env.local`. Both are gitignored.
#
# Production: build-time vars go in the CI environment; runtime secrets are set
# with `wrangler secret put <NAME>` and must never be committed here.
# ---------------------------------------------------------------------------

# --- Contact form (Resend) — runtime, .dev.vars / wrangler secret ----------

# Required to actually deliver contact-form emails. Without it the form still
# validates and verifies, but returns a friendly error instead of sending.
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional. Sender shown on delivered emails, e.g.
#   "Contact Form <contact@rajpoot.dev>"
# Must be on a domain verified in Resend; falls back to the Resend sandbox
# sender (onboarding@resend.dev) if unset.
RESEND_FROM=

# --- Contact-form bot protection (Cloudflare Turnstile) --------------------

# Site key is public and inlined into the client bundle at build time; leave it
# unset locally and the widget simply isn't rendered.
PUBLIC_TURNSTILE_SITE_KEY=

# Secret key is runtime-only (.dev.vars / `wrangler secret put`). When unset the
# endpoint accepts unverified submissions and logs
# `contact.turnstile_unconfigured` — fine for local dev, never for production.
TURNSTILE_SECRET_KEY=

# Create both at https://dash.cloudflare.com/?to=/:account/turnstile

# --- Analytics -------------------------------------------------------------

# Optional, build-time. Cloudflare Web Analytics is pageview-only, so the site's
# custom events (CTA click, CV download, social click, project click, contact
# submit) no-op unless this points at a collector that accepts a JSON POST.
# See src/lib/analytics.ts.
PUBLIC_ANALYTICS_ENDPOINT=

# --- Feature flags ---------------------------------------------------------

# Optional, build-time. Set to "true" to render the testimonials section;
# hidden by default until there are enough real endorsements. Any other value
# (or unset) keeps it hidden.
SHOW_TESTIMONIALS=

# ---------------------------------------------------------------------------
# Managed by tooling — do NOT set these manually:
#   CI            set by the CI environment (GitHub Actions)
#   E2E_TESTING   set by playwright.config.ts during end-to-end runs
# ---------------------------------------------------------------------------
