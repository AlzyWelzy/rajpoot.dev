# ---------------------------------------------------------------------------
# Environment variables for the portfolio site.
#
# Copy this file to `.env.local` and fill in the values you need:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. In production (Cloudflare Workers), set these
# via `wrangler secret put <NAME>` or the dashboard instead of committing them.
# ---------------------------------------------------------------------------

# --- Contact form (Resend) -------------------------------------------------

# Required to actually deliver contact-form emails. Without it the form still
# validates and passes Turnstile, but returns a friendly error instead of
# sending. Create a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional. Sender shown on delivered emails, e.g.
#   "Contact Form <contact@rajpoot.dev>"
# Must be on a domain verified in Resend; falls back to the Resend sandbox
# sender (onboarding@resend.dev) if unset.
RESEND_FROM=

# --- Contact-form anti-abuse (Cloudflare Turnstile) -------------------------

# Both required — without them every submission fails verification with a
# friendly error (there is no fallback path, unlike the other optional vars
# here). NEXT_PUBLIC_TURNSTILE_SITE_KEY is public by design (embedded in the
# rendered HTML) and needed at build time. TURNSTILE_SECRET is sensitive —
# set it via `wrangler secret put TURNSTILE_SECRET` in production, never
# commit it. Create/manage the widget at
# https://dash.cloudflare.com/?to=/:account/turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional. Comma-separated hostnames siteverify's response must match.
# Defaults to the current NEXT_PUBLIC_SITE_URL's host (bare + www) plus
# localhost/127.0.0.1 — only set this if a deploy needs something more
# specific than that default.
TURNSTILE_HOSTNAMES=

# --- Site identity -----------------------------------------------------------

# Optional, build-time. Canonical URL for this deploy — feeds
# metadataBase, JSON-LD, the sitemap, and robots.txt's Host directive
# (lib/seo.ts). This is the one field in siteConfig that's genuinely
# environment-dependent rather than fixed site content, so it lives here
# instead of being hardcoded. Falls back to the current interim domain
# (https://rajpoot.me) if unset.
NEXT_PUBLIC_SITE_URL=

# --- Analytics (Cloudflare Web Analytics) -----------------------------------

# Optional, build-time. Site token from the Cloudflare dashboard's Web
# Analytics section. Without it the beacon script isn't rendered at all —
# pageviews/Core Web Vitals just won't be collected.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Feature flags ---------------------------------------------------------

# Optional, build-time. Set to "true" to render the testimonials section;
# hidden by default until there are enough real endorsements. Any other value
# (or unset) keeps it hidden.
SHOW_TESTIMONIALS=

# ---------------------------------------------------------------------------
# Managed by tooling — do NOT set these manually:
#   NODE_ENV      set by Next.js (development / production / test)
#   CI            set by the CI environment (GitHub Actions)
#   E2E_TESTING   set by playwright.config.ts during end-to-end runs
# ---------------------------------------------------------------------------
