# ---------------------------------------------------------------------------
# Environment variables for the portfolio site.
#
# Copy this file to `.env.local` and fill in the values you need:
#   cp .env.example .env.local
#
# `.env.local` is gitignored. In production (Vercel), set these in the
# project's Environment Variables settings instead of committing them.
# ---------------------------------------------------------------------------

# --- Contact form (Resend) -------------------------------------------------

# Required to actually deliver contact-form emails. Without it the form still
# validates and rate-limits, but returns a friendly error instead of sending.
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional. Sender shown on delivered emails, e.g.
#   "Contact Form <contact@rajpoot.dev>"
# Must be on a domain verified in Resend; falls back to the Resend sandbox
# sender (onboarding@resend.dev) if unset.
RESEND_FROM=

# --- Contact-form abuse gate (Cloudflare Turnstile) ------------------------

# Turnstile replaced the Upstash sliding-window IP rate limit. A
# proof-of-humanity check per submission fits a personal contact form better:
# it stops scripted abuse with no external Redis dependency, and it does not
# punish several genuine visitors who share one NAT'd address.
#
# Both are REQUIRED in production — with no secret set, every submission is
# rejected (fail closed), which is deliberate.
#
# The sitekey is public and inlined into the bundle at build time. Get a pair
# at https://dash.cloudflare.com/?to=/:account/turnstile and register the
# deployment's hostname on the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional, comma-separated. siteverify echoes back the hostname the token was
# minted on and it is checked server-side. Defaults to siteConfig.url's host
# (bare + www) plus localhost/127.0.0.1, which covers local dev and E2E. Set
# this for a deployment on some other domain — e.g. a Vercel preview URL.
TURNSTILE_HOSTNAMES=

# --- Feature flags ---------------------------------------------------------

# Optional, build-time. Set to "true" to render the testimonials section;
# hidden by default until there are enough real endorsements. Any other value
# (or unset) keeps it hidden.
SHOW_TESTIMONIALS=

# ---------------------------------------------------------------------------
# Managed by tooling — do NOT set these manually:
#   NODE_ENV      set by Next.js (development / production / test)
#   CI            set by the CI environment (GitHub Actions)
#   E2E_TESTING   set by playwright.config.ts during end-to-end runs
# ---------------------------------------------------------------------------
