{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-01",
  // resend reaches for node builtins (streams, buffer) at import time.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
    // Deliberately no `run_worker_first`. Letting Cloudflare answer the
    // prerendered HTML and the shortlink redirects straight from edge cache,
    // without waking the Worker, is the entire point of the move — it is what
    // takes TTFB from ~660ms on Vercel (apex 301 -> www CNAME chain) to an edge
    // cache hit. Those responses get their security headers from `_headers`
    // (generated by scripts/gen-headers.mjs); the Worker responses that remain
    // — /api/contact and the PDF routes — get the same set from
    // hooks.server.ts. See src/lib/security-headers.js.
  },

  "observability": {
    "enabled": true,
  },

  // A workers.dev URL for previewing a deploy before it is the live site.
  // Harmless to leave on: it is a separate hostname, and the canonical URL and
  // JSON-LD all point at https://www.rajpoot.dev regardless, so the preview
  // cannot compete with the real domain in search results.
  "workers_dev": true,

  // Staging. new.rajpoot.dev is the full production shape — real domain, real
  // TLS, real Turnstile — without touching the live site, so the cutover can be
  // rehearsed and the contact form tested end to end against real Resend.
  //
  // The apex and www entries stay commented until the cutover: uncommenting
  // them is what actually moves rajpoot.dev off Vercel, since `wrangler deploy`
  // creates the DNS records and starts serving production traffic immediately.
  // Apex -> www stays a Cloudflare Redirect Rule rather than anything in the
  // app; see the deploy section of AGENTS.md.
  "routes": [
    { "pattern": "new.rajpoot.dev", "custom_domain": true },
    // { "pattern": "rajpoot.dev", "custom_domain": true },
    // { "pattern": "www.rajpoot.dev", "custom_domain": true },
  ],

  // No "vars" block. Every runtime value this Worker reads is a secret
  // (RESEND_API_KEY, RESEND_FROM, TURNSTILE_SECRET_KEY) and is set with
  // `wrangler secret put`. SHOW_TESTIMONIALS is a *build*-time flag read while
  // prerendering, so it belongs in the build environment, not here.
}
