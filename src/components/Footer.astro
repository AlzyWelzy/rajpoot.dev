---
import Icon from "@/components/Icon.astro";
import { siteConfig } from "@/lib/seo";

// Social entries point at the internal redirect routes (see public/_redirects),
// so the destination URLs stay defined in one place.
const socialLinks = [
  { label: "GitHub", href: "/github", icon: "bs-github" },
  { label: "LinkedIn", href: "/linkedin", icon: "bs-linkedin" },
  { label: "X (Twitter)", href: "/twitter", icon: "bs-twitter-x" },
  { label: "Instagram", href: "/instagram", icon: "bs-instagram" },
  { label: "Facebook", href: "/facebook", icon: "bs-facebook" },
  { label: "Blog", href: siteConfig.blog, icon: "bs-rss-fill" },
] as const;

const iconLinkClasses =
  "flex min-h-11 min-w-11 items-center justify-center rounded-full focus-ring transition hover:scale-115 hover:text-gray-950 active:scale-105 dark:hover:text-white";
// Built as one string rather than two adjacent `{}` expressions in the
// markup: Prettier splits those across lines and Astro then drops the
// whitespace between them, rendering "© 2026Manvendra Rajpoot".
const copyright = `${new Date().getFullYear()} ${siteConfig.name}`;
---

<!-- No role="contentinfo": a top-level <footer> already exposes that landmark. -->
<footer class="px-4 pb-10 text-center text-gray-600 dark:text-white/70">
  <p class="mb-2 block text-xs">
    <span class="font-semibold"
      >Building scalable, secure backends and AI-powered systems.</span
    > Thanks for stopping by.
  </p>

  <nav
    aria-label="Social links"
    class="mb-3 flex flex-wrap items-center justify-center gap-1 text-lg"
  >
    {
      socialLinks.map(({ label, href, icon }) => (
        <a
          aria-label={label}
          title={label}
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          class={iconLinkClasses}
        >
          <Icon name={icon} class="h-[1em] w-[1em]" />
        </a>
      ))
    }
    <a
      aria-label="Email"
      title="Email"
      href={`mailto:${siteConfig.email}`}
      class={iconLinkClasses}
    >
      <Icon name="bs-envelope" class="h-[1em] w-[1em]" />
    </a>
  </nav>

  <small class="text-xs">&copy; {copyright}. All rights reserved.</small>
</footer>
