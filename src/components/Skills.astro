---
import SectionHeading from "./SectionHeading.astro";
import { skillsData } from "@/lib/data";

// Tailwind needs each utility spelled out somewhere it can statically see
// it — a template-string class name (`bg-${color}-50`) would be purged.
const chipColors = {
  indigo:
    "bg-indigo-50 border-indigo-200 text-indigo-900 dark:bg-indigo-400/10 dark:border-indigo-400/25 dark:text-indigo-200",
  teal: "bg-teal-50 border-teal-200 text-teal-900 dark:bg-teal-400/10 dark:border-teal-400/25 dark:text-teal-200",
  amber:
    "bg-amber-50 border-amber-200 text-amber-900 dark:bg-amber-400/10 dark:border-amber-400/25 dark:text-amber-200",
} as const;
---

<section
  id="skills"
  data-section-name="Skills"
  tabindex="-1"
  aria-label="Skills"
  class="mb-28 max-w-212 scroll-mt-28 text-center outline-none sm:mb-40"
>
  <SectionHeading>My skills</SectionHeading>
  <div class="flex flex-col gap-6">
    {
      skillsData.map((group) => (
        <div>
          <h3 class="mb-3 text-xs font-semibold tracking-widest text-gray-600 uppercase dark:text-white/60">
            {group.category}
          </h3>
          <ul class="flex flex-wrap justify-center gap-2 text-lg">
            {group.skills.map((skill) => (
              <li
                class:list={[
                  "chip-reveal rounded-xl border px-5 py-3",
                  chipColors[group.color],
                ]}
              >
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
