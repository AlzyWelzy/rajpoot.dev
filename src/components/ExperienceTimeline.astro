---
import Icon from "@/components/Icon.astro";
import { experiencesData } from "@/lib/data";
---

<!--
  Single-column timeline: a left rail with icon nodes, cards stacked below
  each other. The old zig-zag alternating layout left huge empty rectangles
  down the page (each card only fills half the row, and the row height is
  set by whichever side is taller) — this reads as a continuous, compact
  column instead. Static markup — no scroll listeners, no client JS — themed
  via the --timeline-* variables in global.css.
-->
<ol class="relative mx-auto mt-12 max-w-165">
  <div
    aria-hidden="true"
    class="absolute left-5 top-0 h-full w-px bg-[color:var(--timeline-arrow)] opacity-40"
  >
  </div>
  {
    experiencesData.map((item) => (
      <li class="relative mb-8 pl-14 last:mb-0">
        <span
          aria-hidden="true"
          class="absolute left-5 top-3 flex h-10 w-10 -translate-x-1/2 items-center justify-center rounded-full text-[1.35rem] ring-1 ring-black/5 bg-[color:var(--timeline-icon-bg)] text-[color:var(--timeline-text)]"
        >
          <Icon name={item.icon} class="h-5 w-5" />
        </span>
        <article class="rounded-lg border border-black/5 bg-[color:var(--timeline-bg)] px-8 py-5 text-left shadow-sm">
          <h3 class="font-semibold text-[color:var(--timeline-text)]">
            {item.title}
          </h3>
          <p class="mt-0 font-normal text-[color:var(--timeline-text)]">
            {item.location}
          </p>
          <p class="mt-1 font-normal text-[color:var(--timeline-muted)]">
            {item.description}
          </p>
          <p class="mt-3 text-sm font-medium uppercase tracking-wide text-[color:var(--timeline-muted)]">
            {item.date}
          </p>
        </article>
      </li>
    ))
  }
</ol>
