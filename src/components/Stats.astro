---
import { projectsData, skillsData, experiencesData } from "@/lib/data";

// Every number here is derived from the site's own data, not hand-typed —
// it can't drift out of sync when a project/skill/role is added or removed.
const CAREER_START = new Date("2023-06-01");
const years = Math.floor(
  (Date.now() - CAREER_START.getTime()) / (365.25 * 24 * 60 * 60 * 1000),
);
const companies = experiencesData.filter((e) => e.icon === "code").length;
const projects = projectsData.length;
const technologies = skillsData.flatMap((group) => group.skills).length;

const stats = [
  { value: years, suffix: "+", label: "Years experience", color: "indigo" },
  { value: companies, suffix: "", label: "Companies", color: "teal" },
  { value: projects, suffix: "", label: "Projects shipped", color: "amber" },
  { value: technologies, suffix: "+", label: "Technologies", color: "pink" },
] as const;

const numberColors = {
  indigo:
    "from-indigo-600 to-purple-600 dark:from-indigo-400 dark:to-purple-400",
  teal: "from-teal-600 to-emerald-600 dark:from-teal-400 dark:to-emerald-400",
  amber: "from-amber-600 to-orange-600 dark:from-amber-400 dark:to-orange-400",
  pink: "from-pink-600 to-rose-600 dark:from-pink-400 dark:to-rose-400",
} as const;
---

<div
  class="fade-reveal mb-28 grid w-full max-w-4xl grid-cols-2 gap-4 px-4 sm:mb-40 sm:grid-cols-4 sm:gap-6"
  data-stats
>
  {
    stats.map((stat) => (
      <div class="rounded-2xl border border-black/5 bg-white px-4 py-6 text-center shadow-sm dark:border-white/10 dark:bg-white/5">
        <p
          class:list={[
            "font-display bg-linear-to-r bg-clip-text text-4xl font-extrabold text-transparent sm:text-5xl",
            numberColors[stat.color],
          ]}
        >
          <span data-count-to={stat.value}>0</span>
          {stat.suffix}
        </p>
        <p class="mt-2 text-sm font-medium text-gray-600 dark:text-white/60">
          {stat.label}
        </p>
      </div>
    ))
  }
</div>

<script>
  // Plain script, not an island — a one-shot count-up triggered by
  // IntersectionObserver, same "no framework needed for a one-off effect"
  // pattern as Intro.astro's nav-click handler.
  const container = document.querySelector<HTMLElement>("[data-stats]");
  if (container) {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const counters = container.querySelectorAll<HTMLElement>("[data-count-to]");

    const animate = () => {
      counters.forEach((el) => {
        const target = Number(el.dataset.countTo);
        if (prefersReducedMotion || target === 0) {
          el.textContent = String(target);
          return;
        }
        const duration = 1200;
        const start = performance.now();
        const tick = (now: number) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0]?.isIntersecting) {
          animate();
          observer.disconnect();
        }
      },
      { threshold: 0.5 },
    );
    observer.observe(container);
  }
</script>
