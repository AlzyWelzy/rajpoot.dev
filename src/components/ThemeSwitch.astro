---
// Server-rendered in the light-theme state; the inline script below syncs it
// to the real theme on load (the pre-hydration script in BaseLayout.astro has
// already set the `dark` class before first paint, so there's no flash).
import Icon from "@/components/Icon.astro";
---

<button
  type="button"
  id="theme-switch"
  aria-label="Switch to dark mode"
  aria-pressed="false"
  title="Switch to dark mode"
  class="fixed bottom-6 right-5 z-50 bg-white/80 w-12 h-12 backdrop-blur-sm border border-white/40 shadow-2xl rounded-full flex items-center justify-center hover:scale-115 active:scale-105 transition-all focus-ring dark:bg-gray-950"
>
  <!-- Stacked icons crossfade + rotate on swap so the most-watched part of
       the interaction has motion. Neutralized by reduced-motion. -->
  <!-- The box is sized in `em` because the icons carry width/height="1em";
       `absolute inset-0` positions them but does not stretch a replaced
       element that already has an intrinsic size. -->
  <span class="relative block h-[1em] w-[1em]" aria-hidden="true">
    <Icon
      name="bs-sun"
      dataIcon="sun"
      class="absolute inset-0 transition-[opacity,transform] duration-300 rotate-0 scale-100 opacity-100"
    />
    <Icon
      name="bs-moon"
      dataIcon="moon"
      class="absolute inset-0 transition-[opacity,transform] duration-300 rotate-90 scale-50 opacity-0"
    />
  </span>
</button>

<script>
  import {
    themeState,
    toggleTheme,
    subscribeTheme,
    type Theme,
  } from "@/lib/stores/theme";

  const button = document.getElementById("theme-switch");
  if (button) {
    const sun = button.querySelector<SVGElement>('[data-icon="sun"]');
    const moon = button.querySelector<SVGElement>('[data-icon="moon"]');

    // Both icons share the same transition classes; only these three vary,
    // so swapping them is the whole crossfade.
    const SHOWN = ["rotate-0", "scale-100", "opacity-100"];
    const HIDDEN_SUN = ["-rotate-90", "scale-50", "opacity-0"];
    const HIDDEN_MOON = ["rotate-90", "scale-50", "opacity-0"];

    function render(theme: Theme) {
      const isDark = theme === "dark";
      const next = isDark ? "light" : "dark";
      button!.setAttribute("aria-label", `Switch to ${next} mode`);
      button!.setAttribute("title", `Switch to ${next} mode`);
      button!.setAttribute("aria-pressed", String(isDark));

      sun?.classList.remove(...SHOWN, ...HIDDEN_SUN);
      sun?.classList.add(...(isDark ? HIDDEN_SUN : SHOWN));
      moon?.classList.remove(...SHOWN, ...HIDDEN_MOON);
      moon?.classList.add(...(isDark ? SHOWN : HIDDEN_MOON));
    }

    render(themeState.value);
    subscribeTheme(render);
    button.addEventListener("click", () => toggleTheme());
  }
</script>
